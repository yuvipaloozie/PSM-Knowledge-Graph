    </node>
    <node id="CAU_1.1.1">
      <data key="d0">Cause</data>
      <data key="d1">Cause</data>
      <data key="d2">8" manual valve downstream of Condensate Feed Pumps PM-53688A/B/C inadvertently closed</data>
    </node>
    <node id="CON_1.1.1.1">
      <data key="d0">Consequence</data>
      <data key="d1">Risk: 2</data>
      <data key="d2">Blocked discharge from Condensate Feed Pumps PM- 111A/B/C; Pump deadhead; Potential seal failure and release of hydrocarbons; Potential ignition and personnel impact</data>
      <data key="d3">4</data>
      <data key="d4">1</data>
      <data key="d5">2</data>
    </node>
    <node id="CON_1.1.1.2">
      <data key="d0">Consequence</data>
      <data key="d1">Risk: </data>
      <data key="d2">Loss of feed flow through the downstream exchanges; See high temperature deviation, this node</data>
      <data key="d3" />
      <data key="d4" />
      <data key="d5" />
    </node>
    <node id="CAU_1.1.2">
